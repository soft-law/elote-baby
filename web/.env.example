# Pool app (/app). Copy to .env.local and fill in. Vite reads these at build time; every value is
# public (it ends up in the browser bundle), so never put a key or a secret here.

# Solana RPC the app reads and sends through.
VITE_RPC_URL=https://api.devnet.solana.com
# Address of the published devnet pool (set once the fixed pool exists).
VITE_POOL_ADDRESS=
# Address of the tMXN test token the pool holds. The app refuses to run if the pool holds another.
VITE_ASSET_MINT=
# Base URL of the mcp/ server: test token faucet and agreements (mcp/.env.example PORT=3010).
VITE_API_URL=http://localhost:3010
# Explorer cluster for links: devnet, testnet or mainnet-beta. Defaults to devnet.
VITE_EXPLORER_CLUSTER=devnet
# 1 registers the keypair test wallet for Playwright. Leave 0 for every real build.
VITE_TEST_WALLET=0
# Test builds only, with VITE_TEST_WALLET=1: the test wallet's 64-byte secret key, base58 or a JSON
# array. Only a throwaway devnet key, never a funded or reused one: a value set at build time ends
# up in the built files.
VITE_TEST_WALLET_SECRET=
