# Port and interface the server listens on.
PORT=3010
HOST=127.0.0.1
# SQLite file for agreements, signatures, anchors and API key digests.
AGREEMENTS_DB=elote-agreements.db
# Human sign pages (sign links point here).
APP_BASE_URL=https://app.soft.law
# Public base URL of this server (evidence download links).
API_BASE_URL=http://localhost:3010
# Comma-separated origins allowed to call /api/* (agreements and the faucet; defaults to the
# APP_BASE_URL origin). Include the origin of the pool app, for example https://elote.baby.
CORS_ORIGINS=

# Devnet faucet (POST /api/faucet). Leave empty to turn it off (the route answers 503).
# Base64 of the faucet key's 64-byte secret key. It holds only the issuing authority of the tMXN
# test token and devnet SOL for fees and account rent; never the pool admin key. Never commit it.
FAUCET_KEYPAIR=
# Address of the fixed tMXN test token the faucet sends.
FAUCET_ASSET_MINT=
# Solana RPC the faucet sends through.
SOLANA_RPC_URL=https://api.devnet.solana.com
